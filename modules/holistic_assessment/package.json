{
  "name": "ghs-holistic-assessment",
  "version": "2.0.0",
  "description": "GHS Holistic Assessment - annual regional and district health sector performance assessment with peer review",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run && npm run test:server",
    "test:server": "node --test \"server/**/*.test.js\"",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"server/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" \"server/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"server/**/*.js\"",
    "verify:indicators": "node scripts/verify-indicator-ids.mjs",
    "indicators:export": "node scripts/sync-indicators.mjs export",
    "indicators:import": "node scripts/sync-indicators.mjs import",
    "indicators:probe": "node scripts/sync-indicators.mjs probe",
    "store:import": "node server/scripts/import-store.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@dhis2/app-runtime": "^3.17.4",
    "@dhis2/d2-i18n": "^1.1.3",
    "@dhis2/ui": "^10.20.0",
    "@fontsource/roboto": "^5.2.6",
    "@vitejs/plugin-react": "^6.2.1",
    "classnames": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
