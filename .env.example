# Copy to .env (Docker) or .env.local (npm run dev).
# Never commit the copy, and never put a real token in this file.

# Port on the host machine (Docker only).
# HOST_PORT=3000

# Sign-in (required; the site stays locked without it). See DEPLOY-DOCKER.md.
# Make a secret with: node scripts/hash-password.mjs --secret
# (or, with no Node on the host: docker compose run --rm dhis2-analysis node scripts/hash-password.mjs --secret)
# AUTH_SECRET=
# Sign in with DHIS2 accounts on this server (defaults to DHIS2_BASE_URL):
# AUTH_DHIS2_URL=https://dhis2.example.org
# Site accounts, from: node scripts/hash-password.mjs <name> "<password>"
# Wrap the value in single quotes in this file: it contains $ signs.
# AUTH_USERS='admin:scrypt$16384$...'
# AUTH_ALLOWED_USERS=kofi,ama
# AUTH_ADMINS=kofi
# AUTH_SESSION_HOURS=12
# The account file. Docker keeps it in the app-data volume (/data/users.json).
# AUTH_STORE=
# For npm run dev only:
# AUTH_DISABLED=true

# Every person connects with their own token on the Connection page. Setting
# DHIS2_BASE_URL alone names the server for sign-in and for Holistic Assessment;
# adding DHIS2_TOKEN pins ONE account for everyone — never do that when
# several people sign in.
# DHIS2_BASE_URL=https://dhis2.example.org
# DHIS2_TOKEN=d2pat_...
# DHIS2_TOKEN_TYPE=ApiToken    # or Bearer

# Only for plain-http access on a trusted internal network. See DEPLOY-DOCKER.md.
# COOKIE_SECURE=false

# Holistic Assessment (/holistic) signs in with each viewer's own DHIS2
# connection. With DHIS2_BASE_URL set it accepts no other server. It is never
# given the token through its environment. Only its database password is its own setting.
# HOLISTIC_DB_PASSWORD=change-me     # letters and digits only; set before first start
# HOLISTIC_REQUIRE_APP_PERMISSION=false
# HOLISTIC_EDIT_GROUPS=GHS HA Editors
# HOLISTIC_REVIEW_GROUPS=GHS HA Reviewers
# HOLISTIC_ADMIN_GROUPS=GHS HA Admins
# For npm run dev, start the module's server on port 3100 (modules/holistic_assessment/README.md).
# HOLISTIC_UPSTREAM_URL=http://localhost:3100

# Where the app reaches the GeoEpi service. Docker Compose sets this for you
# (http://geoepi:8000); for npm run dev, start GeoEpi on port 8000 (README.md).
# GEOEPI_UPSTREAM_URL=http://localhost:8000
