# Copy to .env (Docker) or .env.local (npm run dev). Every setting is optional.
# Never commit the copy, and never put a real token in this file.

# Port on the host machine (Docker only).
# HOST_PORT=3000

# Pin one DHIS2 server for every viewer. The Connection page becomes read-only.
# DHIS2_BASE_URL=https://dhis2.example.org
# DHIS2_TOKEN=d2pat_...
# DHIS2_TOKEN_TYPE=ApiToken    # or Bearer

# Only for plain-http access on a trusted internal network. See DEPLOY-DOCKER.md.
# COOKIE_SECURE=false

# Holistic Assessment (/holistic) signs in with the connection above: the
# pinned DHIS2_BASE_URL/DHIS2_TOKEN, or each viewer's own connection. With
# DHIS2_BASE_URL set it accepts no other server. It is never given the token
# through its environment. Only its database password is its own setting.
# HOLISTIC_DB_PASSWORD=change-me     # letters and digits only; set before first start
# HOLISTIC_REQUIRE_APP_PERMISSION=false
# HOLISTIC_EDIT_GROUPS=GHS HA Editors
# HOLISTIC_REVIEW_GROUPS=GHS HA Reviewers
# HOLISTIC_ADMIN_GROUPS=GHS HA Admins
# For npm run dev, start the module's server on port 3100 (modules/holistic_assessment/README.md).
# HOLISTIC_UPSTREAM_URL=http://localhost:3100

# Where the app reaches the GeoEpi service. Docker Compose sets this for you
# (http://geoepi:8000); for npm run dev, start GeoEpi on port 8000 (README.md).
# GEOEPI_UPSTREAM_URL=http://localhost:8000
