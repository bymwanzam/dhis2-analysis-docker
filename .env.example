# Copy to .env.local for npm run dev. Every setting is optional.
# Never commit the copy, and never put a real token in this file.
# On cPanel, set these in Setup Node.js App → Environment variables instead
# (see DEPLOY-CPANEL.md); nothing from this file travels with the upload.

# Pin one DHIS2 server for every viewer. The Connection page becomes read-only.
# DHIS2_BASE_URL=https://dhis2.example.org
# DHIS2_TOKEN=d2pat_...
# DHIS2_TOKEN_TYPE=ApiToken    # or Bearer

# Only for plain-http access on a trusted internal network, never on cPanel
# (AutoSSL gives HTTPS there, and the login cookie needs it).
# COOKIE_SECURE=false
