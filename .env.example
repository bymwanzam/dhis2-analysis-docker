# Copy to .env (Docker) or .env.local (npm run dev). Every setting is optional.
# Never commit the copy, and never put a real token in this file.

# Port on the host machine (Docker only).
# HOST_PORT=3000

# Pin one DHIS2 server for every viewer. The Connection page becomes read-only.
# DHIS2_BASE_URL=https://dhis2.example.org
# DHIS2_TOKEN=d2pat_...
# DHIS2_TOKEN_TYPE=ApiToken    # or Bearer

# Only for plain-http access on a trusted internal network. See DEPLOY-DOCKER.md.
# COOKIE_SECURE=false

# Where the app reaches the GeoEpi service. Docker Compose sets this for you
# (http://geoepi:8000); for npm run dev, start GeoEpi on port 8000 (README.md).
# GEOEPI_UPSTREAM_URL=http://localhost:8000
