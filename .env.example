# Copy to .env.local for npm run dev. Every setting is optional.
# Never commit the copy, and never put a real token in this file.
# On cPanel, set these in Setup Node.js App → Environment variables instead
# (see DEPLOY-CPANEL.md); nothing from this file travels with the upload.

# Sign-in (required; the site stays locked without it). See DEPLOY-CPANEL.md.
# Make a secret with: node scripts/hash-password.mjs --secret
# AUTH_SECRET=
# Sign in with DHIS2 accounts on this server:
# AUTH_DHIS2_URL=https://dhis2.example.org
# Site accounts, from: node scripts/hash-password.mjs <name> "<password>"
# AUTH_USERS=admin:scrypt$16384$...
# AUTH_ALLOWED_USERS=kofi,ama
# AUTH_SESSION_HOURS=12
# For npm run dev only:
# AUTH_DISABLED=true

# Every person connects with their own token on the Connection page; leave these
# unset for that. Setting both pins ONE account for everyone.
# DHIS2_BASE_URL=https://dhis2.example.org
# DHIS2_TOKEN=d2pat_...
# DHIS2_TOKEN_TYPE=ApiToken    # or Bearer

# Only for plain-http access on a trusted internal network, never on cPanel
# (AutoSSL gives HTTPS there, and the login cookie needs it).
# COOKIE_SECURE=false
